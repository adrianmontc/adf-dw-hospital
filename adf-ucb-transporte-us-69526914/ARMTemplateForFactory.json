					"scriptLines": [
						"source(output(",
						"          patient_id as string,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as string,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source1 derive(patient_id = toInteger(trim(patient_id)),",
						"          full_name = trim(full_name),",
						"          gender = case(\r",
						"  upper(trim(gender)) == 'M' || upper(trim(gender)) == 'MALE', 'Male',\r",
						"  upper(trim(gender)) == 'F' || upper(trim(gender)) == 'FEMALE', 'Female',\r",
						"  'Other'\r",
						"),",
						"          date_of_birth = coalesce(   toDate(trim(date_of_birth), 'yyyy-MM-dd'),   toDate(trim(date_of_birth), 'MM/dd/yyyy'),   toDate(trim(date_of_birth), 'MM-dd-yy'),   toDate(trim(date_of_birth), 'dd-MMM-yyyy'),   toDate(trim(date_of_birth), 'MMMM dd, yyyy') ),",
						"          phone = iif(isNull(phone) || lower(trim(phone)) == 'unknown', toString(null()), regexReplace(trim(phone), '[^0-9]', '')),",
						"          email = iif(isNull(email), toString(null()), replace(replace(lower(trim(email)), ',', '.'), '@gmial.com', '@gmail.com')),",
						"          address = trim(address),",
						"          insurance_provider = case(   isNull(insurance_provider), 'Self-Pay',   instr(upper(insurance_provider), 'MEDICAID') > 0, 'Medicaid',   instr(upper(insurance_provider), 'MEDICARE') > 0 || instr(upper(insurance_provider), 'MEDI-CARE') > 0, 'Medicare',   instr(upper(insurance_provider), 'CIGNA') > 0, 'Cigna',   instr(upper(insurance_provider), 'AETNA') > 0, 'Aetna',   instr(upper(insurance_provider), 'BLUE') > 0, 'BlueCross',   instr(upper(insurance_provider), 'UNITED') > 0 || instr(upper(insurance_provider), 'UHC') > 0, 'UnitedHealth',   instr(upper(insurance_provider), 'SELF') > 0, 'Self-Pay',   'Other' )) ~> derivedColumn1",
						"derivedColumn1 filter(!isNull(patient_id) && !isNull(full_name)) ~> filter1",
						"filter1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          patient_id,",
						"          full_name,",
						"          gender,",
						"          date_of_birth,",
						"          phone,",
						"          email,",
						"          address,",
						"          insurance_provider",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/dw_bronze_patients_sql')]",
				"[concat(variables('factoryId'), '/datasets/dw_silver_patients_sql')]"
