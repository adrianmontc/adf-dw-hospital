		{
			"name": "[concat(parameters('factoryName'), '/df_silver_admissions')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "dw_bronze_admissions_sql",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "dw_silver_admissions_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "filter1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as string,",
						"          patient_id as string,",
						"          admission_date as string,",
						"          discharge_date as string,",
						"          department as string,",
						"          attending_doctor_id as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source1 derive(admission_id = toInteger(trim(admission_id)),",
						"          patient_id = toInteger(trim(patient_id)),",
						"          admission_date = coalesce(   toDate(trim(admission_date), 'yyyy-MM-dd'),   toDate(trim(admission_date), 'MM/dd/yyyy'),   toDate(trim(admission_date), 'MM-dd-yy'),   toDate(trim(admission_date), 'dd-MMM-yyyy'),   toDate(trim(admission_date), 'MMMM dd, yyyy') ),",
						"          discharge_date = coalesce(   toDate(trim(discharge_date), 'yyyy-MM-dd'),   toDate(trim(discharge_date), 'MM/dd/yyyy'),   toDate(trim(discharge_date), 'MM-dd-yy'),   toDate(trim(discharge_date), 'dd-MMM-yyyy'),   toDate(trim(discharge_date), 'MMMM dd, yyyy') ),",
						"          department = case(   instr(upper(trim(department)), 'ONCO') > 0, 'Oncology',   instr(upper(trim(department)), 'CARDIO') > 0, 'Cardiology',   instr(upper(trim(department)), 'EMERG') > 0 || upper(trim(department)) == 'ER', 'Emergency',   instr(upper(trim(department)), 'PED') > 0 || instr(upper(trim(department)), 'PAED') > 0, 'Pediatrics',   instr(upper(trim(department)), 'ORTHO') > 0, 'Orthopedics',   instr(upper(trim(department)), 'SURG') > 0, 'General Surgery',   instr(upper(trim(department)), 'NEURO') > 0 || instr(upper(trim(department)), 'NUERO') > 0, 'Neurology',   'General' ),",
						"          attending_doctor_id = toInteger(trim(attending_doctor_id))) ~> derivedColumn1",
						"derivedColumn1 derive(admission_date = iif(   isNull(admission_date),   discharge_date,   iif(!isNull(discharge_date) && discharge_date < admission_date, discharge_date, admission_date) ),",
						"          discharge_date = iif(   !isNull(discharge_date) && !isNull(admission_date) && discharge_date < admission_date,   admission_date,   discharge_date )) ~> derivedColumn2",
						"derivedColumn2 filter(!isNull(admission_id) && !isNull(patient_id) && patient_id <= 1015 && !isNull(admission_date) && !isNull(department) && !isNull(attending_doctor_id)) ~> filter1",
						"filter1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          admission_id,",
						"          patient_id,",
						"          admission_date,",
						"          discharge_date,",
						"          department,",
						"          attending_doctor_id",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/dw_bronze_admissions_sql')]",
				"[concat(variables('factoryId'), '/datasets/dw_silver_admissions_sql')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_billing')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "dw_bronze_billing_sql",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "dw_silver_admissions_sql",
								"type": "DatasetReference"
							},
							"name": "source2"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "dw_silver_billing_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "filter1"
						},
						{
							"name": "exists1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          billing_id as string,",
						"          admission_id as string,",
						"          charge_type as string,",
						"          amount as string,",
						"          payment_status as string,",
						"          payment_date as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source(output(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source2",
						"source1 derive(billing_id = toInteger(trim(billing_id)),",
						"          admission_id = toInteger(trim(admission_id)),",
						"          charge_type = iif(isNull(charge_type) || trim(charge_type) == '', 'Unspecified', trim(charge_type)),",
						"          amount = coalesce(\r",
						"  toDecimal(abs(toDouble(regexReplace(trim(amount), '[^0-9.-]', ''))), 12, 2),\r",
						"  toDecimal(0.00, 12, 2)\r",
						"),",
						"          payment_status = case(   upper(trim(payment_status)) == 'PAID', 'Paid',   upper(trim(payment_status)) == 'UNPAID', 'Unpaid',   upper(trim(payment_status)) == 'PENDING', 'Pending',   upper(trim(payment_status)) == 'OVERDUE', 'Overdue',   'Pending' ),",
						"          payment_date = iif(   upper(trim(payment_status)) != 'PAID',   toDate(null()),   coalesce(     toDate(trim(payment_date), 'yyyy-MM-dd'),     toDate(trim(payment_date), 'MM/dd/yyyy'),     toDate(trim(payment_date), 'MM-dd-yy'),     toDate(trim(payment_date), 'dd-MMM-yyyy'),     toDate(trim(payment_date), 'MMMM dd, yyyy')   ) )) ~> derivedColumn1",
						"derivedColumn1 filter(!isNull(billing_id) && !isNull(admission_id) && !isNull(charge_type) && !isNull(amount) && amount > 0 && !isNull(payment_status)) ~> filter1",
						"filter1, source2 exists(derivedColumn1@admission_id == source2@admission_id,",
						"     negate:false,",
						"     broadcast: 'auto')~> exists1",
						"exists1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          billing_id as integer,",
						"          admission_id as integer,",
						"          charge_type as string,",
						"          amount as decimal(12,2),",
						"          payment_status as string,",
						"          payment_date as date",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          billing_id,",
						"          admission_id,",
						"          charge_type,",
						"          amount,",
						"          payment_status,",
						"          payment_date",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/dw_bronze_billing_sql')]",
				"[concat(variables('factoryId'), '/datasets/dw_silver_admissions_sql')]",
				"[concat(variables('factoryId'), '/datasets/dw_silver_billing_sql')]"
			]
		},
