{
	"name": "df_gold_fact_admisiones",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_paciente",
						"type": "DatasetReference"
					},
					"name": "dimpaciente"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_departamento",
						"type": "DatasetReference"
					},
					"name": "dimdepartamento"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_diagnostico",
						"type": "DatasetReference"
					},
					"name": "dimdiagnostico"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_fecha",
						"type": "DatasetReference"
					},
					"name": "dimfecha"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_fact_admisiones",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "lookup1"
				},
				{
					"name": "lookup2"
				},
				{
					"name": "lookup3"
				},
				{
					"name": "lookup4"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id_bk as integer,",
				"          patient_id as integer,",
				"          department as string,",
				"          icd_code as string,",
				"          severity as string,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          fecha_alta_key as integer,",
				"          medico_id as integer,",
				"          dias_estancia as integer,",
				"          conteo_admisiones as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    a.admission_id AS admission_id_bk,\\n    a.patient_id,\\n    a.department,\\n    d.icd_code,\\n    ISNULL(d.severity, \\'Unspecified\\') AS severity,\\n    a.admission_date,\\n    a.discharge_date,\\n    CASE \\n        WHEN a.discharge_date IS NULL THEN NULL \\n        ELSE YEAR(a.discharge_date) * 10000 + MONTH(a.discharge_date) * 100 + DAY(a.discharge_date) \\n    END AS fecha_alta_key,\\n    a.attending_doctor_id AS medico_id,\\n    DATEDIFF(DAY, a.admission_date, a.discharge_date) AS dias_estancia,\\n    1 AS conteo_admisiones\\nFROM silver.admissions a\\nINNER JOIN silver.diagnoses d ON a.admission_id = d.admission_id',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimpaciente",
				"source(output(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimdepartamento",
				"source(output(",
				"          diagnostico_key as integer,",
				"          codigo_icd as string,",
				"          descripcion_patologia as string,",
				"          nivel_severidad as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimdiagnostico",
				"source(output(",
				"          fecha_key as integer,",
				"          fecha_completa as date,",
				"          anio as integer,",
				"          trimestre as integer,",
				"          trimestre_nombre as string,",
				"          mes as integer,",
				"          mes_nombre as string,",
				"          mes_corto as string,",
				"          semana_anio as integer,",
				"          dia_mes as integer,",
				"          dia_semana as integer,",
				"          dia_nombre as string,",
				"          es_fin_de_semana as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimfecha",
				"source1, dimpaciente lookup(patient_id == patient_id_bk,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1, dimdepartamento lookup(department == nombre_departamento,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup2",
				"lookup2, dimdiagnostico lookup(icd_code == codigo_icd",
				"     && severity == nivel_severidad,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup3",
				"lookup3, dimfecha lookup(admission_date == fecha_completa,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup4",
				"lookup4 select(mapColumn(",
				"          admission_id_bk,",
				"          fecha_alta_key,",
				"          medico_id,",
				"          dias_estancia,",
				"          conteo_admisiones,",
				"          paciente_key,",
				"          departamento_key,",
				"          diagnostico_key,",
				"          fecha_key",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admision_key as long,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          diagnostico_key as integer,",
				"          fecha_ingreso_key as integer,",
				"          fecha_alta_key as integer,",
				"          medico_id as integer,",
				"          dias_estancia as integer,",
				"          conteo_admisiones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id_bk,",
				"          paciente_key,",
				"          departamento_key,",
				"          diagnostico_key,",
				"          fecha_ingreso_key = fecha_key,",
				"          fecha_alta_key,",
				"          medico_id,",
				"          dias_estancia,",
				"          conteo_admisiones",
				"     )) ~> sink1"
			]
		}
	}
}