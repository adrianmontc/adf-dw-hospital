{
	"name": "df_gold_fact_facturacion",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_paciente",
						"type": "DatasetReference"
					},
					"name": "dimpaciente"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_departamento",
						"type": "DatasetReference"
					},
					"name": "dimdepartamento"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_servicio_cargo",
						"type": "DatasetReference"
					},
					"name": "dimserviciocargo"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_fecha",
						"type": "DatasetReference"
					},
					"name": "dimfecha"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_fact_facturacion",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "lookup1"
				},
				{
					"name": "lookup2"
				},
				{
					"name": "lookup3"
				},
				{
					"name": "lookup4"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          patient_id as integer,",
				"          department as string,",
				"          charge_type as string,",
				"          payment_status as string,",
				"          payment_date as date,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    b.billing_id AS billing_id_bk,\\n    b.admission_id AS admission_id_bk,\\n    a.patient_id,\\n    a.department,\\n    b.charge_type,\\n    b.payment_status,\\n    b.payment_date,\\n    b.amount AS monto_facturado,\\n    1 AS conteo_transacciones\\nFROM silver.billing b\\nINNER JOIN silver.admissions a ON b.admission_id = a.admission_id',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimpaciente",
				"source(output(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimdepartamento",
				"source(output(",
				"          servicio_cargo_key as integer,",
				"          tipo_cargo as string,",
				"          estado_pago as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimserviciocargo",
				"source(output(",
				"          fecha_key as integer,",
				"          fecha_completa as date,",
				"          anio as integer,",
				"          trimestre as integer,",
				"          trimestre_nombre as string,",
				"          mes as integer,",
				"          mes_nombre as string,",
				"          mes_corto as string,",
				"          semana_anio as integer,",
				"          dia_mes as integer,",
				"          dia_semana as integer,",
				"          dia_nombre as string,",
				"          es_fin_de_semana as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimfecha",
				"source1, dimpaciente lookup(patient_id == patient_id_bk,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1, dimdepartamento lookup(department == nombre_departamento,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup2",
				"lookup2, dimserviciocargo lookup(charge_type == tipo_cargo",
				"     && payment_status == estado_pago,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup3",
				"lookup3, dimfecha lookup(payment_date == fecha_completa,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup4",
				"lookup4 select(mapColumn(",
				"          billing_id_bk,",
				"          admission_id_bk,",
				"          monto_facturado,",
				"          conteo_transacciones,",
				"          paciente_key,",
				"          departamento_key,",
				"          servicio_cargo_key,",
				"          fecha_pago_key = fecha_key",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          facturacion_key as long,",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id_bk,",
				"          admission_id_bk,",
				"          paciente_key,",
				"          departamento_key,",
				"          servicio_cargo_key,",
				"          fecha_pago_key,",
				"          monto_facturado,",
				"          conteo_transacciones",
				"     )) ~> sink1"
			]
		}
	}
}